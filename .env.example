# Copy to .env and fill in locally. Never commit .env.
# Every variable is optional: without any, the app runs in deterministic
# mode on the fictional bank demo project.

# --- LLM provider (anthropic | bedrock | azure-foundry | none) -------------
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# AWS Bedrock (adapter tested with mocks only; requires an injected transport)
AWS_REGION=
BEDROCK_MODEL_ID=

# Azure AI Foundry (adapter tested with mocks only)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=

# --- Connectors (read-only) -------------------------------------------------
# Fine-grained token with read access to contents, pull requests, actions.
GITHUB_TOKEN=
GITHUB_API_URL=

# Jira Cloud: base URL + email + API token. Data Center: base URL + PAT, no email.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# SonarQube (local: docker compose -f docker/docker-compose.sonarqube.yml up -d)
SONARQUBE_URL=
SONARQUBE_TOKEN=
SONARQUBE_SCANNER_TOKEN=

# --- Server -------------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
XDMFS_DB_PATH=data/xdmfs.sqlite
XDMFS_DEFAULT_PROJECT=aurore-pay
